{
  "name": "streamx-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-stream recording and monitoring desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc -b && vite build",
    "desktop": "electron .",
    "install:electron": "install-electron",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "hls.js": "^1.6.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
